    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "accept-language-parser": "1.5.0",
    "expr-eval": "2.0.2",
    "i18next": "26.4.3",
    "i18next-icu": "2.5.0",
    "immer": "11.1.21",
    "intl-messageformat": "12.1.3",
    "lru-cache": "11.5.3",
    "next": "16.4.0",
    "normalize.css": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-use": "17.6.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@kachkaev/eslint-config-next": "2.0.0",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@tsconfig/next": "2.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/accept-language-parser": "1.5.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.49.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.10",
    "suppress-exit-code": "4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
