    "@visx/group": "3.0.0",
    "@visx/scale": "3.0.0",
    "@visx/shape": "3.0.0",
    "accept-language-parser": "1.5.0",
    "expr-eval": "2.0.2",
    "i18next": "22.4.9",
    "i18next-icu": "2.1.0",
    "immer": "9.0.17",
    "intl-messageformat": "10.2.5",
    "lru-cache": "7.14.1",
    "next": "16.3.8",
    "normalize.css": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "12.1.4",
    "react-use": "17.4.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@kachkaev/eslint-config-react": "0.5.1",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@next/eslint-plugin-next": "13.1.1",
    "@tsconfig/next": "2.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/accept-language-parser": "1.5.3",
    "@types/lru-cache": "7.10.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "8.31.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
